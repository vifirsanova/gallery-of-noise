build cmake_object_order_depends_target_integration_tests: phony || cmake_object_order_depends_target_app_modules cmake_object_order_depends_target_audio cmake_object_order_depends_target_core cmake_object_order_depends_target_ui

build CMakeFiles/integration_tests.dir/tests/test_integration.cpp.o: CXX_COMPILER__integration_tests_unscanned_Release /home/vector/Downloads/synth/tests/test_integration.cpp || cmake_object_order_depends_target_integration_tests
  CONFIG = Release
  DEFINES = -DBIOMUSIC_HAVE_ALSA=1 -DBIOMUSIC_HAVE_CATCH2=1 -DBIOMUSIC_HAVE_RTMIDI=1 -DBIOMUS_HAS_SDL2=1
  DEP_FILE = CMakeFiles/integration_tests.dir/tests/test_integration.cpp.o.d
  FLAGS = -O3 -DNDEBUG -std=c++17 -Wall -Wextra -Wpedantic
  INCLUDES = -I/home/vector/Downloads/synth/include -I/usr/include/rtmidi -isystem /usr/include/SDL2
  OBJECT_DIR = CMakeFiles/integration_tests.dir
  OBJECT_FILE_DIR = CMakeFiles/integration_tests.dir/tests
  TARGET_COMPILE_PDB = CMakeFiles/integration_tests.dir/
  TARGET_PDB = integration_tests.pdb
  TARGET_SUPPORT_DIR = CMakeFiles/integration_tests.dir


# =============================================================================
# Link build statements for EXECUTABLE target integration_tests


#############################################
# Link the executable integration_tests

build integration_tests: CXX_EXECUTABLE_LINKER__integration_tests_Release CMakeFiles/integration_tests.dir/tests/test_integration.cpp.o | libcore.a libaudio.a libui.a libapp_modules.a /usr/lib/libCatch2Main.a /usr/lib/libasound.so /usr/lib/libSDL2-2.0.so.0.3200.74 libcore.a /usr/lib/libCatch2.a || libapp_modules.a libaudio.a libcore.a libui.a
  CONFIG = Release
  DEP_FILE = CMakeFiles/integration_tests.dir/link.d
  FLAGS = -O3 -DNDEBUG
  LINK_FLAGS = -Wl,--dependency-file=CMakeFiles/integration_tests.dir/link.d
  LINK_LIBRARIES = libcore.a  libaudio.a  libui.a  libapp_modules.a  /usr/lib/libCatch2Main.a  /usr/lib/libasound.so  /usr/lib/libSDL2-2.0.so.0.3200.74  libcore.a  -lrtmidi  /usr/lib/libCatch2.a
  OBJECT_DIR = CMakeFiles/integration_tests.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = CMakeFiles/integration_tests.dir/
  TARGET_FILE = integration_tests
  TARGET_PDB = integration_tests.pdb
  TARGET_SUPPORT_DIR = CMakeFiles/integration_tests.dir


#############################################
# Utility command for test

build CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /home/vector/Downloads/synth/build && /usr/bin/ctest
  DESC = Running tests...
  pool = console
  restat = 1

build test: phony CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/vector/Downloads/synth/build && /usr/bin/ccmake -S/home/vector/Downloads/synth -B/home/vector/Downloads/synth/build
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/vector/Downloads/synth/build && /usr/bin/cmake --regenerate-during-build -S/home/vector/Downloads/synth -B/home/vector/Downloads/synth/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util


#############################################
# Build dependencies for test core_unit_tests

build test_prep/core_unit_tests: phony tests


#############################################
# Build dependencies for test system_integration_tests

build test_prep/system_integration_tests: phony integration_tests


#############################################
# Build dependencies for all tests

build test_prep/all: phony test_prep/core_unit_tests test_prep/system_integration_tests

# =============================================================================
# Target aliases.

build app_modules: phony libapp_modules.a

build audio: phony libaudio.a

build core: phony libcore.a

build ui: phony libui.a

# =============================================================================
# Folder targets.

# =============================================================================

#############################################
# Folder: /home/vector/Downloads/synth/build

build all: phony libcore.a libaudio.a libui.a libapp_modules.a app render_wav tests integration_tests

